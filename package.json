{
    "name": "obsidian-language-study",
    "version": "1.0.0",
    "description": "阅读、查词、复习、使用、统计全部合一的语言学习 Obsidian 插件",
    "main": "main.js",
    "packageManager": "pnpm@11.5.2",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "dev": "vp build --watch --mode development",
        "typecheck": "vue-tsc --noEmit --skipLibCheck",
        "test": "vp test run",
        "deploy": "pnpm build && node scripts/deploy-icloud.mjs",
        "lint": "vp lint --tsconfig tsconfig.json .",
        "format": "vp fmt --write --no-error-on-unmatched-pattern \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{ts,mjs,mts,json,jsonc}\"",
        "format:check": "vp fmt --check --no-error-on-unmatched-pattern \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{ts,mjs,mts,json,jsonc}\"",
        "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check",
        "build": "pnpm typecheck && pnpm test && vp build --mode production && pnpm check:mobile-bundle",
        "check:mobile-bundle": "node scripts/check-mobile-bundle.mjs",
        "pub": "node publish.mjs",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [],
    "author": "Shawn",
    "license": "MIT",
    "dependencies": {
        "@vueuse/core": "^15.0.0",
        "ac-auto": "^2.0.0",
        "dexie": "^4.4.6",
        "dexie-export-import": "^4.4.1",
        "downloadjs": "^1.4.7",
        "echarts": "^6.1.0",
        "monkey-around": "^3.0.0",
        "nlcst-to-string": "^4.0.0",
        "parse-english": "^7.0.0",
        "retext-english": "^5.0.0",
        "unified": "^11.0.5",
        "unist-util-modify-children": "^4.0.0",
        "unist-util-visit": "^5.1.0",
        "vue": "3.6.0-rc.12"
    },
    "devDependencies": {
        "@types/downloadjs": "^1.4.6",
        "@types/nlcst": "^2.0.3",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^21.0.3",
        "hash-sum": "^2.0.0",
        "naive-ui": "^2.45.3",
        "obsidian": "1.14.4",
        "sass": "^1.105.2",
        "tslib": "2.8.1",
        "typescript": "6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "vue-tsc": "^3.3.13"
    }
}
